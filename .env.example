# Required services
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/socratic_chat"
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
RAG_MODEL="gpt-4.1-mini"
# Local chat inference through Ollama. Its API key is a required client placeholder
# and is ignored by the local Ollama server.
LLM_PROVIDER="ollama"
OLLAMA_API_KEY="ollama"
OLLAMA_API_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="qwen3.5:9b-q4_K_M"
OLLAMA_CLASSIFIER_MODEL="qwen3.5:9b-q4_K_M"
OLLAMA_ANSWER_EVALUATION_MODEL="qwen3.5:9b-q4_K_M"
OLLAMA_GENERATION_MAX_TOKENS="600"

# Optional hosted-chat alternative. Embeddings continue to use the OpenAI settings above.
GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_CLASSIFIER_MODEL="openai/gpt-oss-120b"
GROQ_ANSWER_EVALUATION_MODEL="openai/gpt-oss-120b"
# Local document and query embeddings. Qwen3 Embedding 0.6B returns 1,024 dimensions.
EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="qwen3-embedding:0.6b"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1024"
# Accept a chunk when it has a sparse text match or reaches this cosine similarity.
RAG_MIN_DENSE_SIMILARITY="0.42"
RAG_MIN_SPARSE_SCORE="0.05"
DEBUG_PIPELINE_LOGS="true"
PIPELINE_LOG_FILE="backend/storage/pipeline.log"
LOG_FULL_PROMPTS="true"
PIPELINE_PROMPT_DIR="backend/storage/pipeline_prompts"

# OpenAI fallback settings used only when LLM_PROVIDER="openai".
CLASSIFIER_ENABLED="true"
CLASSIFIER_MODEL=""
CLASSIFIER_TEMPERATURE="0"
CLASSIFIER_MAX_TOKENS="500"
CLASSIFIER_MAX_HISTORY="6"

ANSWER_EVALUATION_ENABLED="true"
ANSWER_EVALUATION_MODEL=""
ANSWER_EVALUATION_MAX_TOKENS="900"

# UNC Charlotte Google authentication
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
AUTH_MODE="school_google"
ALLOWED_GOOGLE_DOMAINS="charlotte.edu"
AUTH_SESSION_SECRET="generate-a-long-random-value"
AUTH_SESSION_MINUTES="60"
ALLOW_PASSWORD_LOGIN="true"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8001,http://localhost:8001,https://jamesonthehill.github.io,https://jamesonthehill.com"
ADMIN_EMAILS="your-admin-account@charlotte.edu"

# Require a uniquely linked GitHub account after school Google verification
REQUIRE_GITHUB_ACCOUNT="true"
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
GITHUB_CALLBACK_URL="https://socratic-chat-api.onrender.com/api/auth/github/callback"
FRONTEND_URL="https://jamesonthehill.com/Socratic-Chat/"

# Optional email/password registration; ignored in school_google mode
REQUIRE_EMAIL_VERIFICATION="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
EMAIL_CODE_EXPIRY_MINUTES="10"
