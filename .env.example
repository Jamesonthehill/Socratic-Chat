# Required services
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"
# Accept a chunk when it has a sparse text match or reaches this cosine similarity.
RAG_MIN_DENSE_SIMILARITY="0.42"

# Optional Groq generation provider. When configured, Groq generates tutor
# responses while OpenAI continues to create the retrieval embeddings.
GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# Hybrid message interpretation. The classifier uses the generation provider
# above unless CLASSIFIER_MODEL names a separate compatible model.
CLASSIFIER_ENABLED="true"
CLASSIFIER_MODEL=""
CLASSIFIER_TEMPERATURE="0"
CLASSIFIER_MAX_TOKENS="300"
CLASSIFIER_MAX_HISTORY="6"

# Hybrid student-answer evaluation. Defaults to GROQ_MODEL (GPT-OSS-120B)
# when Groq is configured, otherwise RAG_MODEL.
ANSWER_EVALUATION_ENABLED="true"
ANSWER_EVALUATION_MODEL=""
ANSWER_EVALUATION_MAX_TOKENS="1600"

# UNC Charlotte Google authentication
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
AUTH_MODE="school_google"
ALLOWED_GOOGLE_DOMAINS="charlotte.edu"
AUTH_SESSION_SECRET="generate-a-long-random-value"
AUTH_SESSION_MINUTES="60"
ALLOW_PASSWORD_LOGIN="true"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8001,http://localhost:8001,https://jamesonthehill.github.io,https://jamesonthehill.com"
ADMIN_EMAILS="your-admin-account@charlotte.edu"

# Require a uniquely linked GitHub account after school Google verification
REQUIRE_GITHUB_ACCOUNT="true"
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
GITHUB_CALLBACK_URL="https://socratic-chat-api.onrender.com/api/auth/github/callback"
FRONTEND_URL="https://jamesonthehill.com/Socratic-Chat/"

# Optional email/password registration; ignored in school_google mode
REQUIRE_EMAIL_VERIFICATION="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
EMAIL_CODE_EXPIRY_MINUTES="10"
