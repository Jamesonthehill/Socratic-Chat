FROM node:22-bookworm-slim AS frontend
WORKDIR /build/platform_frontend
COPY platform_frontend/package*.json ./
RUN npm ci
COPY platform_frontend/ ./
COPY reflections-app/frontend/src/ /build/reflections-app/frontend/src/
COPY adaptive-learning-app/student-app/src/ /build/adaptive-learning-app/student-app/src/
RUN npm run build

FROM python:3.12-slim
WORKDIR /workspace
RUN apt-get update \
    && apt-get install -y --no-install-recommends antiword catdoc libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
COPY Socratic-Chat/backend/requirements.txt Socratic-Chat/backend/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY platform_app/ platform_app/
COPY vendor/reflection_analysis/ vendor/reflection_analysis/
COPY scripts/ scripts/
COPY Socratic-Chat/backend/app/ Socratic-Chat/backend/app/
COPY Socratic-Chat/frontend/ Socratic-Chat/frontend/
COPY student-agent-bot/data/topics/builtin/ student-agent-bot/data/topics/builtin/
COPY --from=frontend /build/platform_frontend/dist/ platform_frontend/dist/
RUN mkdir -p Socratic-Chat/backend/storage Socratic-Chat/backend/data/raw_docs
COPY reflections-app/backend/requirements.txt /tmp/reflections-requirements.txt
COPY adaptive-learning-app/backend/requirements.txt /tmp/sdl-requirements.txt
RUN python -m venv /opt/reflections && python -m venv /opt/sdl \
    && for env in /opt/reflections /opt/sdl; do \
         "$env/bin/pip" install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu || exit 1; \
       done \
    && /opt/reflections/bin/pip install --no-cache-dir -r /tmp/reflections-requirements.txt \
    && /opt/sdl/bin/pip install --no-cache-dir torchvision --index-url https://download.pytorch.org/whl/cpu \
    && /opt/sdl/bin/pip install --no-cache-dir -r /tmp/sdl-requirements.txt
COPY reflections-app/backend/app/ reflections-app/backend/app/
COPY adaptive-learning-app/backend/app/ adaptive-learning-app/backend/app/
COPY adaptive-learning-app/backend/lessons/ adaptive-learning-app/backend/lessons/
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
STOPSIGNAL SIGTERM
CMD ["python", "-m", "scripts.run_combined"]
